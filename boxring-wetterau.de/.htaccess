# Non-www auf www umleiten (Duplicate-Content-Vermeidung, siehe Issue #50)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^boxring-wetterau\.de$ [NC]
RewriteRule ^(.*)$ https://www.boxring-wetterau.de/$1 [R=301,L]

# Sicherheits-Header (siehe Issue #52)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
